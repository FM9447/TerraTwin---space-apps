{
  "name": "terratwin-backend",
  "version": "1.0.0",
  "description": "TerraTwin Backend Service - Scientific Planetary Analog Discovery & NASA Dataset Processing Engine",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "fetch:images": "node scripts/fetchGameImages.js",
    "fetch:assets": "node scripts/fetchSiteAssets.js",
    "seed": "node src/db/seed.js",
    "seed:reset": "node src/db/seed.js --force-images --force-assets",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "mongoose": "^9.12.1"
  },
  "keywords": [
    "nasa",
    "earth-observation",
    "moon",
    "mars",
    "planetary-analogs",
    "gis",
    "geospatial"
  ],
  "author": "TerraTwin Team",
  "license": "MIT"
}
